<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_payment_target_tree" model="ir.ui.view">
        <field name="name">re.payment.target.list</field>
        <field name="model">re.payment.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="allotment_id"/>
                <field name="name"/>
                <field name="amount_bdt"/>
                <field name="paid_bdt"/>
                <field name="due_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_re_payment_target_form" model="ir.ui.view">
        <field name="name">re.payment.target.form</field>
        <field name="model">re.payment.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="allotment_id"/>
                        <field name="name"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_bdt"/>
                        <field name="paid_bdt"/>
                        <field name="due_date"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_re_payment_target" model="ir.actions.act_window">
        <field name="name">Payment Targets</field>
        <field name="res_model">re.payment.target</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
