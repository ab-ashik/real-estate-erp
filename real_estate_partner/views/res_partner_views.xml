<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_re" model="ir.ui.view">
        <field name="name">res.partner.form.re</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Project Client">
                    <field name="re_partner_type"/>
                    <field name="re_status"/>
                    <field name="nid"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
