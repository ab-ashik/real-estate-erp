<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_payment_submission_tree" model="ir.ui.view">
        <field name="name">re.payment.submission.list</field>
        <field name="model">re.payment.submission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_bdt"/>
                <field name="payment_date"/>
                <field name="method"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_re_payment_submission_form" model="ir.ui.view">
        <field name="name">re.payment.submission.form</field>
        <field name="model">re.payment.submission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="allotment_id"/>
                        <field name="target_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_bdt"/>
                        <field name="payment_date"/>
                        <field name="method"/>
                        <field name="paid_from"/>
                        <field name="paid_to"/>
                        <field name="reference"/>
                        <field name="evidence" filename="evidence_filename"/>
                        <field name="evidence_filename" invisible="1"/>
                        <field name="remarks"/>
                        <field name="reject_reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_re_payment_submission" model="ir.actions.act_window">
        <field name="name">Payment Submissions</field>
        <field name="res_model">re.payment.submission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
