<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_project_tree" model="ir.ui.view">
        <field name="name">re.project.list</field>
        <field name="model">re.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="status"/>
                <field name="progress_percent"/>
            </list>
        </field>
    </record>
    <record id="view_re_project_form" model="ir.ui.view">
        <field name="name">re.project.form</field>
        <field name="model">re.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="status"/>
                        <field name="location"/>
                        <field name="progress_percent"/>
                    </group>
                    <notebook>
                        <page string="Flats">
                            <field name="flat_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_re_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">re.project</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
