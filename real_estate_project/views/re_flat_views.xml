<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_flat_tree" model="ir.ui.view">
        <field name="name">re.flat.list</field>
        <field name="model">re.flat</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="code"/>
                <field name="size_sft"/>
                <field name="price_bdt"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_re_flat_form" model="ir.ui.view">
        <field name="name">re.flat.form</field>
        <field name="model">re.flat</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="code"/>
                        <field name="floor"/>
                        <field name="flat_type"/>
                        <field name="size_sft"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price_bdt"/>
                        <field name="status"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_re_flat" model="ir.actions.act_window">
        <field name="name">Flats</field>
        <field name="res_model">re.flat</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
